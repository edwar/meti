# ============================================
# Meti — Variables de entorno
# Copia este archivo a .env y completa los valores
# ============================================

# --- Base de datos (Neon Postgres) ---
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth (better-auth) ---
# Genera un secreto con: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# --- Google OAuth ---
# https://console.cloud.google.com/apis/credentials
# URI de redireccion: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Mercado Pago (opcional, solo pagos reales) ---
MERCADOPAGO_ACCESS_TOKEN=""

# --- LiveKit Cloud (opcional, solo videollamadas) ---
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_URL=""

# --- Groq (opcional) ---
GROQ_API_KEY=""
